NODE_ENV=development
API_KEY='YOUR_API_KEY'
PORT=3002
WEBHOOK_SECRET='webhook_secret'
IDP_WEBHOOK_PATH=/api/webhooks/socure/event
DEFAULT_IDP_DOCV_CALLBACK_URL='http://localhost:3000/verify/socure/document_capture_update'
# Optional. When set, the proofing agent webhook requires this value in the
# Authorization header. Leave unset in lower environments to disable the check.
PROOFING_AGENT_WEBHOOK_SECRET=''